    private static <T> void styleCombo(JComboBox<T> box) {
        box.setUI(new ModernComboUI());
        box.setRenderer(new ComboItemRenderer());
        box.setOpaque(false);
        box.setBorder(BorderFactory.createEmptyBorder());
        box.setFont(Theme.font(Font.PLAIN, 13.5f));
